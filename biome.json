{
  "$schema": "https://biomejs.dev/schemas/2.3.3/schema.json",
  "files": {
    "includes": ["**", "!package-lock.json", "!build"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@aws-sdk/client-dynamodb",
                  "@aws-sdk/client-dynamodb/**",
                  "@aws-sdk/lib-dynamodb",
                  "@aws-sdk/lib-dynamodb/**"
                ],
                "message": "Use the authorized operations in src/data."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["test/interactions-smoke-fixture.mts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/data/index.mts",
        "src/data/class-news.mts",
        "src/data/retention.mts",
        "test/recruiting-retention.test.mts",
        "test/data-local.test.mts",
        "src/interactions/index.mts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
